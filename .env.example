# .env ở thư mục gốc: dùng cho docker compose (db / api / app) và scripts/setup.mjs.
# Dev không Docker dùng backend/.env + admin/.env (npm run setup tự tạo từ .env.example của từng thư mục).

# ---- Cổng / DB
# PostgreSQL trên máy host
DB_PORT=5433
# API (profile api / app)
API_PORT=3000
# Admin web qua nginx (profile app)
ADMIN_PORT=8080
# Tên database (dev: backend/.env dùng cùng tên; container api cũng dùng tên này)
API_DB=tracker

# ---- Bảo mật: bắt buộc khi chạy container, >= 16 ký tự (npm run setup tự sinh nếu còn trống)
JWT_SECRET=
JWT_EXPIRES_IN=30d

# ---- Admin được seed tự tạo / nâng quyền (bỏ trống = không tạo)
ADMIN_EMAIL=admin@thuchi.vn
ADMIN_PASSWORD=admin123

# ---- true => mỗi lần container api khởi động nạp lại dữ liệu demo (chỉ user @demo.thuchi.vn + demo@thuchi.vn)
SEED_DEMO=false

# ---- Mạng
# Origin được gọi API trực tiếp, phân cách dấu phẩy (admin qua nginx cùng origin nên không cần)
CORS_ORIGINS=
# API đứng sau nginx của service admin => 1 hop. Chạy API trực tiếp ra Internet thì để trống
TRUST_PROXY=1

# ---- SMTP gửi OTP quên mật khẩu (SMTP_HOST trống => OTP in ra log API)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TrackerX <no-reply@trackerx.app>"
