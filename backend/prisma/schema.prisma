generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  LOCKED
}

enum TxType {
  INCOME
  EXPENSE
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
  EARLY_WITHDRAWN
}

enum GoalEntryType {
  DEPOSIT
  WITHDRAW
}

enum WalletType {
  CASH
  BANK
  EWALLET
}

enum NotificationType {
  BUDGET_WARNING
  BUDGET_EXCEEDED
  BROADCAST
  RECURRING_PAUSED
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  /// Tăng lên => mọi JWT cũ (mang tv khác) bị từ chối: đổi/đặt lại mật khẩu, bị khóa, đăng xuất mọi thiết bị
  tokenVersion Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  categories     Category[]
  transactions   Transaction[]
  budgets        Budget[]
  savingGoals    SavingGoal[]
  wallets        Wallet[]
  transfers      Transfer[]
  notifications  Notification[]
  quickTemplates QuickTemplate[]
  passwordReset  PasswordReset?
  recurringRules RecurringRule[]
  savingEntries  SavingEntry[]
  aiConversations AiConversation[]
  aiMessages      AiMessage[]
  aiDrafts        AiDraft[]
  aiFeedback      AiFeedback[]
  aiMemory        AiMemory[]
  aiExamples      AiExample[]
  aiRules         AiRule[]
  aiSetting       AiUserSetting?
  loginFailures   LoginFailure[]
}

/// Lần đăng nhập SAI của tài khoản có thật (không lưu mật khẩu đã nhập) — để phát hiện dò mật khẩu. Giữ 30 ngày.
model LoginFailure {
  id        String   @id @default(uuid())
  userId    String
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Ví / tài khoản tiền. Số dư luôn tính từ dữ liệu (initialBalance + phát sinh), không lưu cộng dồn.
model Wallet {
  id             String     @id @default(uuid())
  userId         String
  name           String
  type           WalletType @default(CASH)
  initialBalance BigInt     @default(0)
  icon           String     @default("wallet")
  color          String     @default("#0EA5E9")
  isArchived     Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  transfersOut   Transfer[]      @relation("TransferFrom")
  transfersIn    Transfer[]      @relation("TransferTo")
  savingEntries  SavingEntry[]
  quickTemplates QuickTemplate[]
  recurringRules RecurringRule[]

  @@index([userId])
}

/// Chuyển tiền giữa 2 ví của cùng user. Không tính vào thu/chi.
model Transfer {
  id           String   @id @default(uuid())
  userId       String
  fromWalletId String
  toWalletId   String
  amount       BigInt
  note         String?
  occurredAt   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromWallet Wallet @relation("TransferFrom", fields: [fromWalletId], references: [id], onDelete: NoAction)
  toWallet   Wallet @relation("TransferTo", fields: [toWalletId], references: [id], onDelete: NoAction)

  @@index([userId, occurredAt])
  @@index([fromWalletId])
  @@index([toWalletId])
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  type        NotificationType
  title       String
  body        String
  data        Json?
  readAt      DateTime?
  broadcastId String?
  createdAt   DateTime         @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  broadcast Broadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

/// Lịch sử thông báo admin gửi cho toàn bộ user ACTIVE.
model Broadcast {
  id          String   @id @default(uuid())
  title       String
  body        String
  createdById String?
  recipients  Int
  createdAt   DateTime @default(now())

  notifications Notification[]
}

/// Mẫu nhập nhanh: 1 chạm tạo giao dịch thật.
model QuickTemplate {
  id         String   @id @default(uuid())
  userId     String
  label      String
  title      String
  amount     BigInt
  categoryId String
  walletId   String
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  wallet   Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// OTP quên mật khẩu: mỗi user tối đa 1 mã còn hiệu lực (mã mới ghi đè mã cũ).
model PasswordReset {
  userId    String   @id
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// userId = null => danh mục hệ thống (admin quản lý, dùng chung cho mọi user)
model Category {
  id         String   @id @default(uuid())
  userId     String?
  name       String
  type       TxType
  icon       String   @default("ellipsis")
  color      String   @default("#64748B")
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  budgets        Budget[]
  quickTemplates QuickTemplate[]
  recurringRules RecurringRule[]

  @@index([userId])
}

model Transaction {
  id              String    @id @default(uuid())
  userId          String
  categoryId      String
  walletId        String
  type            TxType
  amount          BigInt
  title           String
  note            String?
  occurredAt      DateTime
  /// Sinh từ giao dịch định kỳ: rule + kỳ (unique => không sinh trùng)
  recurringRuleId String?
  scheduledFor    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  wallet        Wallet         @relation(fields: [walletId], references: [id], onDelete: NoAction)
  recurringRule RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)

  @@unique([recurringRuleId, scheduledFor])
  @@index([userId, occurredAt])
  @@index([categoryId])
  @@index([walletId])
}

/// Hạn mức chi trong một tháng (month = "YYYY-MM"). categoryId = null => ngân sách tổng (mỗi user/tháng tối đa 1, kiểm tra ở service).
model Budget {
  id          String    @id @default(uuid())
  userId      String
  categoryId  String?
  month       String
  limitAmount BigInt
  /// Dấu đã gửi thông báo ngưỡng 80% / 100% (mỗi ngưỡng 1 lần)
  warnedAt    DateTime?
  exceededAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
}

model SavingGoal {
  id           String     @id @default(uuid())
  userId       String
  name         String
  targetAmount BigInt
  savedAmount  BigInt     @default(0)
  startDate    DateTime
  targetDate   DateTime
  icon         String     @default("star")
  color        String     @default("#3498DB")
  status       GoalStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries SavingEntry[]

  @@index([userId])
}

/// Sổ nạp/rút của mục tiêu tiết kiệm. Nạp = tiền rời ví, rút = tiền về ví.
/// Xóa mục tiêu không xóa sổ (goalId => null) để số dư từng ví không bị đổi.
model SavingEntry {
  id        String        @id @default(uuid())
  userId    String
  goalId    String?
  walletId  String
  type      GoalEntryType
  amount    BigInt
  date      DateTime
  createdAt DateTime      @default(now())

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal   SavingGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  wallet Wallet      @relation(fields: [walletId], references: [id], onDelete: NoAction)

  @@index([userId])
  @@index([goalId])
  @@index([walletId])
}

/// Giao dịch định kỳ. Ngày tính theo giờ VN; MONTHLY/YEARLY giữ anchorDay (31 -> cuối tháng thiếu ngày -> 31 lại).
model RecurringRule {
  id         String    @id @default(uuid())
  userId     String
  walletId   String
  categoryId String
  amount     BigInt
  title      String
  note       String?
  frequency  Frequency
  interval   Int       @default(1)
  startDate  DateTime
  /// Hết ngày này (cuối ngày giờ VN) thì dừng
  endDate    DateTime?
  anchorDay  Int
  nextRunAt  DateTime
  lastRunAt  DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet       Wallet        @relation(fields: [walletId], references: [id], onDelete: NoAction)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  transactions Transaction[]

  @@index([userId])
  @@index([isActive, nextRunAt])
}

/// Cấu hình hệ thống do admin sửa (key = "<section>.<field>"). Không có dòng => dùng giá trị mặc định (env / hành vi cũ).
/// Giá trị bí mật (mật khẩu SMTP) lưu dạng mã hóa AES-256-GCM.
model SystemSetting {
  key           String   @id
  value         Json
  updatedAt     DateTime @updatedAt
  updatedById   String?
  updatedByName String?
}

/// Lịch sử thay đổi cấu hình: mỗi trường đổi một dòng. actorId null = hệ thống (vd tự tắt bảo trì).
/// Trường bí mật lưu "••••" cho cả giá trị cũ và mới.
model SystemConfigChange {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  actorId    String?
  actorName  String?
  actorEmail String?
  section    String
  key        String
  oldValue   Json?
  newValue   Json?
  secret     Boolean  @default(false)

  @@index([createdAt])
  @@index([section, createdAt])
}

/* ============================== Trợ lý AI ==============================
 * Mọi dòng dữ liệu của user đều có userId (FK cascade => xóa tài khoản xóa sạch).
 * Chỉ truy cập qua AiRepo (src/ai/ai.store.ts) — repo bắt buộc có principal từ JWT.
 * Dòng phạm vi GLOBAL (luật / ví dụ chung) có userId = null và chỉ chứa dữ liệu đã ẩn danh. */

/// USER = hội thoại của người dùng; ADMIN = hội thoại của quản trị viên (skill admin). Lấy theo role lúc tạo.
enum AiScope {
  USER
  ADMIN
}

enum AiMessageRole {
  USER
  ASSISTANT
}

enum AiDraftStatus {
  PROPOSED
  /// Đang thực thi (chặn xác nhận 2 lần đồng thời)
  EXECUTING
  CONFIRMED
  EDITED
  CANCELLED
}

/// Phạm vi của ví dụ / luật: riêng 1 user hay chung (đã ẩn danh)
enum AiKnowledgeScope {
  USER
  GLOBAL
}

enum AiKnowledgeStatus {
  PROPOSED
  ACTIVE
  REJECTED
}

model AiConversation {
  id        String   @id @default(uuid())
  userId    String
  scope     AiScope
  title     String?
  archived  Boolean  @default(false)
  /// Ghim: không bị tự lưu trữ khi đạt giới hạn số hội thoại
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId, updatedAt])
}

model AiMessage {
  id             String        @id @default(uuid())
  conversationId String
  /// Trùng với conversation.userId (lọc trực tiếp + đếm hạn mức/ngày)
  userId         String
  role           AiMessageRole
  content        String
  /// Skill xử lý (tin của assistant)
  skill          String?
  /// rule | knn | learned | fallback | reroute
  routeBy        String?
  /// ok | ask | error | unsupported
  status         String        @default("ok")
  latencyMs      Int?
  promptTokens   Int?
  evalTokens     Int?
  /// Gợi ý câu tiếp theo, thông tin chẩn đoán (luật đã áp, số shot...) — không chứa dữ liệu user khác
  meta           Json?
  createdAt      DateTime      @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  draft        AiDraft?
  feedback     AiFeedback[]

  @@index([conversationId, createdAt])
  @@index([userId, role, createdAt])
  @@index([skill, createdAt])
}

/// Nháp do skill đề xuất; chỉ thực thi khi user xác nhận (qua service nghiệp vụ sẵn có).
model AiDraft {
  id           String        @id @default(uuid())
  messageId    String        @unique
  userId       String
  skill        String
  /// transactions | budgets | broadcast | lock_user | search_filter
  kind         String
  payload      Json
  status       AiDraftStatus @default(PROPOSED)
  finalPayload Json?
  /// Kết quả thực thi (vd {created: 2}) — trả lại nguyên vẹn khi xác nhận lặp (idempotent)
  result       Json?
  resolvedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  message AiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([skill, status, createdAt])
}

/// Tín hiệu học: kết quả nháp (DRAFT_OUTCOME), sửa định tuyến "ý tôi là…" (REROUTE), thích / không thích (THUMBS).
model AiFeedback {
  id        String   @id @default(uuid())
  userId    String
  messageId String
  /// DRAFT_OUTCOME | REROUTE | THUMBS
  kind      String
  skill     String?
  /// confirmed | edited | cancelled (DRAFT_OUTCOME)
  outcome   String?
  fromSkill String?
  toSkill   String?
  /// +1 / -1 (THUMBS)
  rating    Int?
  /// Khác biệt nháp → bản cuối (DRAFT_OUTCOME edited)
  diff      Json?
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  message AiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, kind])
  @@index([userId, createdAt])
  @@index([kind, createdAt])
}

/// Trí nhớ riêng của user (ví hay dùng, biệt danh…), có bộ đếm có ích / có hại.
model AiMemory {
  id         String    @id @default(uuid())
  userId     String
  /// vd "wallet.default", "category.frequent:<tên>"
  key        String
  value      String
  helpful    Int       @default(0)
  harmful    Int       @default(0)
  /// confirm | edit | reroute | user
  source     String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

/// Kho ví dụ (few-shot kNN / câu mẫu router). USER = riêng user; GLOBAL = chung, đã ẩn danh (userId null).
model AiExample {
  id            String            @id @default(uuid())
  scope         AiKnowledgeScope
  userId        String?
  /// userId hoặc "global" (unique không dính NULL)
  ownerKey      String
  /// Skill dùng ví dụ ("router" = câu mẫu định tuyến)
  skill         String
  input         String
  /// Chuẩn hóa còn dấu (khóa trùng)
  inputNorm     String
  output        Json
  /// Float32 little-endian (kNN trong tiến trình; sau này thay bằng pgvector)
  embedding     Bytes?
  embedModel    String?
  confirmations Int               @default(1)
  /// Số user khác nhau đóng góp (GLOBAL)
  userCount     Int               @default(1)
  status        AiKnowledgeStatus @default(ACTIVE)
  approvedById  String?
  approvedAt    DateTime?
  evalReport    Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ownerKey, skill, inputNorm])
  @@index([scope, skill, status])
}

/// Luật học được: pattern (chuỗi chuẩn hóa CÒN DẤU) → value (danh mục / skill). kind: category | route.
model AiRule {
  id           String            @id @default(uuid())
  scope        AiKnowledgeScope
  userId       String?
  ownerKey     String
  skill        String
  kind         String
  pattern      String
  value        String
  /// Số lần quan sát pattern → value
  support      Int               @default(0)
  helpful      Int               @default(0)
  harmful      Int               @default(0)
  userCount    Int               @default(1)
  precision    Float?
  status       AiKnowledgeStatus @default(PROPOSED)
  approvedById String?
  approvedAt   DateTime?
  evalReport   Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ownerKey, kind, pattern, value])
  @@index([scope, kind, status])
}

/// Bộ đề hồi quy (chung, ẩn danh) cho cổng kiểm định luật / ví dụ chung.
model AiEvalCase {
  id        String   @id @default(uuid())
  skill     String
  input     String
  inputNorm String
  expected  Json
  /// seed | approved
  source    String
  createdAt DateTime @default(now())

  @@unique([skill, inputNorm])
}

/// Lịch sử chạy chu trình học ban đêm.
model AiLearningRun {
  id         String    @id @default(uuid())
  trigger    String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  stats      Json?
  error      String?
}

/// Cài đặt AI của user. shareExamples = đồng ý góp ví dụ ẩn danh vào kho chung (hỏi 1 lần, tắt được); consentedAt = lúc đồng ý gần nhất.
model AiUserSetting {
  userId        String    @id
  shareExamples Boolean   @default(false)
  consentedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
