DATABASE_URL="postgresql://tracker:tracker@localhost:5433/tracker?schema=public"
PORT=3000
JWT_SECRET="change-me"
JWT_EXPIRES_IN="30d"
CORS_ORIGINS="http://localhost:*,http://127.0.0.1:*,https://tracker-xt.freepro.online"
ADMIN_EMAIL="admin@thuchi.vn"
ADMIN_PASSWORD="admin123"
# production => tắt các endpoint run-due (404) và JWT_SECRET phải >= 16 ký tự; test => nới rate limit cho e2e
NODE_ENV="development"
# SMTP gửi OTP quên mật khẩu. Bỏ trống SMTP_HOST => OTP được in ra log server (dev / e2e)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="TrackerX <no-reply@trackerx.app>"
# Rate limit login/register/reset-password (và forgot-password chặt hơn), theo IP + route. Mặc định 60s / 10 / 3 (NODE_ENV=test: 10s / 200 / 20)
# THROTTLE_TTL_SEC=60
# THROTTLE_AUTH_LIMIT=10
# THROTTLE_FORGOT_LIMIT=3
# Sau reverse proxy: 1 (số hop) | true | danh sách IP
# TRUST_PROXY=
# Khóa mã hóa giá trị bí mật trong Cấu hình hệ thống (mật khẩu SMTP). Bỏ trống => dẫn xuất từ JWT_SECRET
# CONFIG_SECRET=""
# Trợ lý AI: mặc định cho mục "ai" của Cấu hình hệ thống. AI_PROVIDER=ollama|fake ghi đè cấu hình (NODE_ENV=test => fake)
# AI_PROVIDER=
# OLLAMA_URL="http://localhost:11434"
# AI_CHAT_MODEL="qwen3.5:4b"
# AI_EMBED_MODEL="bge-m3"
# Thư mục ai/ của repo (parser, prompt, skill ngoài). Mặc định <repo>/ai. AI_EXTERNAL_SKILLS=0 => chỉ dùng skill built-in
# AI_DIR=
# AI_EXTERNAL_SKILLS=1
