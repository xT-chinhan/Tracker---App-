DATABASE_URL="postgresql://tracker:tracker@localhost:5433/tracker?schema=public"
PORT=3000
JWT_SECRET="change-me"
JWT_EXPIRES_IN="30d"
CORS_ORIGINS="http://localhost:5173"
ADMIN_EMAIL="admin@tracker.local"
ADMIN_PASSWORD="admin123"
# production => tắt POST /recurring/run-due (endpoint chỉ dùng cho dev/test)
NODE_ENV="development"
# SMTP gửi OTP quên mật khẩu. Bỏ trống SMTP_HOST => OTP được in ra log server (dev / e2e)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="App Tracker <no-reply@tracker.local>"
