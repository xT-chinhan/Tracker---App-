<!-- Bản APK "thường" (TRACKERX_LITE=1): gỡ dịch vụ đọc thông báo ngân hàng.
     Play Protect (chống lừa đảo nâng cao, đang áp dụng ở Việt Nam) chặn APK cài ngoài Google Play nếu app khai báo
     BIND_NOTIFICATION_LISTENER_SERVICE / đọc SMS / trợ năng. Bản đầy đủ (có tính năng này) cài qua USB (adb). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <application>
        <service android:name=".banknotif.BankNotificationListener" tools:node="remove" />
    </application>
</manifest>
